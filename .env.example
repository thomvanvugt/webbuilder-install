# Webbuilder - instellingen van deze installatie.
#
# Normaal maakt install.sh dit bestand voor je aan, met willekeurige
# wachtwoorden. Met de hand: kopieer naar ".env" en vul de VERVANG_MIJ-regels in.
# Deel ".env" nooit: hier staan de echte wachtwoorden en sleutels in.
#
# Naam, website-adres, mail enz. stel je in via de installatie-wizard en
# later via accountmenu -> Systeeminstellingen. Die gaan voor op dit bestand.

# --- Docker ---
COMPOSE_PROJECT_NAME=webbuilder
# https      = Caddy regelt HTTPS voor DOMAIN (weglaten als je al een reverse proxy hebt)
# autoupdate = elke nacht back-up + automatisch bijwerken
COMPOSE_PROFILES=https,autoupdate
# Volledige map van deze installatie (nodig voor back-ups en bijwerken).
PROJECT_DIR=/opt/webbuilder
IMAGE_PREFIX=ghcr.io/thomvanvugt/webbuilder
# latest = altijd de nieuwste versie; of vastzetten, bv. 1.2.0
WEBBUILDER_VERSION=latest
AUTO_UPDATE=true
# Uur van back-up en update (Nederlandse tijd). Zo nodig herstart de computer
# om 05:00 voor systeemupdates (beveilig-server.sh).
UPDATE_HOUR=4
BACKUP_KEEP=14
# Nieuwe versies pas na zoveel dagen installeren (0 = meteen, voor testkastjes;
# bv. 3 voor de kastjes van verenigingen).
UPDATE_DELAY_DAYS=0

# --- Bereikbaarheid ---
# 1 = NetBird (mini-pc bij een vereniging), 2 = Caddy met eigen domein, 3 = eigen reverse proxy
ACCESS_MODE=2
# Met Caddy: de domeinnaam (moet naar deze server wijzen).
DOMAIN=www.voorbeeld.nl
# Eigen reverse proxy (bv. Nginx Proxy Manager)? Dan FRONTEND_BIND=0.0.0.0
# en je proxy doorsturen naar FRONTEND_PORT.
# Met NetBird: het NetBird-adres van deze computer (zet install.sh zelf).
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8110
# Aantal proxies vóór de backend (NetBird/Caddy/eigen proxy + de website zelf),
# zodat het echte IP-adres van bezoekers wordt gezien. Controle:
# Systeeminstellingen -> Verbinding.
TRUST_PROXY=2

# --- Meldingen en bewaking (optioneel) ---
# Pushmelding (ntfy) bij problemen: back-up mislukt, update teruggedraaid,
# website draait niet, account geblokkeerd, nieuwe beheerder.
NTFY_URL=
NTFY_TOKEN=
# Uptime Kuma push-monitors: elke 5 minuten "leeft", en na elke gelukte nachtelijke back-up.
HEARTBEAT_URL=
BACKUP_HEARTBEAT_URL=

# --- Beheerservice (optioneel; zet beheerservice.sh dit voor je) ---
# Versleutelde externe back-up (restic, append-only) naar de beheerder.
# OFFSITE_REPO=rest:http://<naam>:<wachtwoord>@<adres>:8000/<naam>/
# OFFSITE_PASSWORD=

# --- Waar de gegevens staan (standaard ./data/... in deze map) ---
# Op TrueNAS bv. /mnt/pool/webbuilder/pgdata en /mnt/pool/webbuilder/uploads.
# PGDATA_PATH=./data/postgres
# UPLOADS_PATH=./data/uploads

# --- Database ---
POSTGRES_USER=webbuilder
POSTGRES_DB=webbuilder
# openssl rand -hex 24
POSTGRES_PASSWORD=VERVANG_MIJ

# --- Geheimen (nooit meer wijzigen na de eerste start) ---
# openssl rand -hex 32
JWT_SECRET=VERVANG_MIJ
# openssl rand -hex 32  (versleutelt 2FA-geheimen en opgeslagen mailwachtwoorden)
TOTP_ENCRYPTION_KEY=VERVANG_MIJ
JWT_EXPIRES_IN=7d

# --- Installatie-wizard ---
# Code die je in de wizard invult. Leeg = de server maakt er zelf een en
# zet die in de logs (docker compose logs backend | grep -i installatiecode).
SETUP_CODE=

APP_TIMEZONE=Europe/Amsterdam

# --- Oude manier (werkt nog steeds) ---
# Alles hieronder kan ook in Systeeminstellingen. Staat het hier, dan geldt
# het zolang het daar niet is ingevuld.
# APP_NAME=Mijn vereniging
# PUBLIC_APP_URL=https://www.voorbeeld.nl
# ADMIN_EMAIL=...   (+ ADMIN_PASSWORD: beheerder bij elke start gelijkzetten, zonder wizard)
# SMTP_HOST= SMTP_PORT=587 SMTP_USER= SMTP_PASS= SMTP_FROM= MAIL_REPLY_TO= CONTACT_EMAIL=
# NEWSLETTER_SMTP_HOST= NEWSLETTER_SMTP_PORT= NEWSLETTER_SMTP_USER= NEWSLETTER_SMTP_PASS= NEWSLETTER_SMTP_FROM=
# EVENT_REMINDER_HOURS_BEFORE=24
# MAIL_DIGEST_HOUR=8
